# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ---- HomeCraft: local-only files, never commit ----
# env (backend/.env.example is the committed template)
.env
.env.local
.env.*.local

# Python bytecode
__pycache__/
*.py[cod]

# SQLite database — holds accounts, password hashes and orders
*.db
*.db-journal
*.db-wal
*.db-shm

# JWT signing secret generated on first run
backend/.secret
.secret

# user-uploaded images (folder kept via .gitkeep)
backend/uploads/*
!backend/uploads/.gitkeep

# build / packaging artifacts
*.tsbuildinfo
public/HomeCraft-complete.zip
